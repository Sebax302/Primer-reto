Algoritmo Acceso_laboratorio_computo
    // Declaraciones
    Definir estudiante, carnet, autorizacion Como Caracter
    // Cuerpo
    Escribir "¿Es estudiante? (si/no)"
    Leer estudiante
    Escribir "¿Tiene carnet vigente? (si/no)"
    Leer carnet
    Escribir "¿Tiene autorizacion especial? (si/no)"
    Leer autorizacion
    Si estudiante = "si" Entonces
        Si carnet = "si" Entonces
            Escribir "Ingreso permitido"
        Sino
            Escribir "Ingreso denegado: carnet no vigente"
        FinSi
    Sino
        Si autorizacion = "si" Entonces
            Escribir "Ingreso temporal"
        Sino
            Escribir "Ingreso denegado"
        FinSi
    FinSi
FinAlgoritmo

 
  
