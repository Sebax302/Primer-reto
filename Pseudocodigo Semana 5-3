Algoritmo Costo_envío_peso_volumétrico
  //Declaraciones
  Definir pesoreal, largo, ancho, alto, pvolumetrico, tarifa pesoacobrar, costototal Como Real
  //Cuerpo
  Escribir"Ingrese el peso real"
    Leer pesoreal
  Escribir"Ingrese el largo"
    Leer largo
  Escrbiir"Ingrese el ancho"
    Leer ancho
  Escribir"Ingrese el alto"
    Leer alto
  tarifa <- $2.50 
  pvolumetrico <- (largo × ancho × alto) / 5000
  Si pesoreal > pvolumetrico Entonces
        pesoacobrar <- pesoreal
    SiNo
        pesoacobrar <- pvolumetrico
    FinSi
    costototal <- pesoacobrar * tarifa
    Escribir "El peso volumetrico es: ", pvolumetrico
    Escribir "El peso a cobrar es: ", pesoacobrar
    Escribir "El costo total es: ", costototal
Fin_Algoritmo
