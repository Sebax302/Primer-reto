Algoritmo Descuento libreria_Loja
Inicio
  //Declaraciones
  Definir estudiante, como caracter 
  Definir descuento, mcompra, total como real
   Escribir "¿Es estudiante UTPL? (si/no)"
    Leer estudiante
    Escribir"Ingrese el monto de la compra"
      Leer mcompra
     descuento <- 0
  Si estudiante = "si" Entonces
        descuento <- 20
        Si mcompra > 30 Entonces
            descuento <- descuento + 5
        FinSi
    SiNo
        Si mcompra > 50 Entonces
            descuento <- 10
        FinSi
    FinSi
    total <- mcompra - (mcompra * descuento / 100)
    Escribir "Descuento aplicado: ", descuento, "%"
    Escribir "Descuento en dolares: $", monto * descuento / 100
    Escribir "Monto final a pagar: $", total
FinAlgoritmo
