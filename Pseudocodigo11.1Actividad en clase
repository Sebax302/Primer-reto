Algoritmo_Maximo_Comun_Divisor
  //Declaraciones
  Definir n1, n2 ,res como entero
  //Cuerpo
  Escribir"Ingrese el primer numero"
    Leer n1
  Escribir"Ingrese el segundo numero"
    Leer n2
  si n1 > n2 entonces
    mientras n1 mod n2 <> 0 hacer
      res <- n1 mod n2
      n1 <- n2
      n2 <- res
    FinMientras
  Sino
    n1 <- n2
    n2 <- n1
    mientras n1 mod n2 <> 0 hacer 
       res <- n1 mod n2
       n1 <- n2
       n2 <- res
    FinMientras
  FinSi
  Escribir "El Maximo Comun divisor, (MCD) es: ", n2
Fin_Algoritmo
