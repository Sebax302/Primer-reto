Algoritmo Calculo_Energia_Electrica
  //Declaraciones
  Definir potencia, horasd, tarifa, consumom, costot como real
  //Cuerpo
  Escribir"Ingrese potencia (W) del electrodomestico "
    Leer potencia
  Escribiir"Ingrese horas de uso dierio del electrodomestico"
    Leer horasd
  Escribir"Ingrese tarifa por kWh"
  consumom <- (potencia/1000) * horas * 30
  costot <- consumom * kWh
  Escribir"El consumo mnensual es:", consumom
  Escribir"El costo total es:", costot
Fin_Algoritmo
