Algoritmo Incremento_Salarial
    // Declaraciones
    Definir salario como real
    Definir anio como entero
    //Cuerpo
    salario <- 1500
    Para anio <- 1 Hasta 6 Hacer
        salario <- salario * 1.10
        Escribir "Salario del año ", anio , salario
    FinPara
    Escribir "Salario final despues de 6 años:", salario
FinAlgoritmo
