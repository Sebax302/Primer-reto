Algoritmo Simulacion_ahorro
    //Declaraciones
    Definir N, i Como Entero
    Definir aporte, saldo Como Real
    //Cuerpo
      Escribir "Ingrese el numero de meses"
        Leer N
    saldo <- 0
    Para i <- 1 Hasta N Hacer
        Escribir "Ingrese el aporte del mes"
        Leer aporte
        saldo <- (saldo + aporte) * 1.008
    FinPara
    Escribir "El saldo final es:", saldo
Fin_Algoritmo
