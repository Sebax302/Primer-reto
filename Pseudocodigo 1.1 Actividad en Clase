Algoritmo Amortizacion_Prestamo_Simple
  //Declaraciones
  Definir monto, tasam, interes, cuotam como real
  Definir nmeses como entero
  //Cuerpo
  Escribir"Ingrese el monto del prestamo"
    Leer monto
  Escribir"Ingrese la tasa mensual en porcentaje "
    Leer tasam
  Escribir"Ingrese el numero de meses"
  Leer nmeses
    interes <- monto * (tasam / 100) * nmeses
    cuotam <- (monto + interes) / nmeses
    Escribir"El interes total es:", interes
    Escribir"La cuota mensual es:", cuotam
Fin_Algoritmo 
