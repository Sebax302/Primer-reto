Algoritmo Cálculo_hipotenusa_área_triángulo_rectángulo
  //Declaraciones
  Definir cateto1, cateto2, area , hipotenusa como real
  //Cuerpo
  Escribir"Ingrese el primer cateto"
    Leer cateto1
  Escribir"Ingrese el segundo cateto"
    Leer cateto2
  hipotenusa <- sqrt (cateto1^2 + cateto2)^2
  area <- (cateto1 x cateto2) / 2
  Escribiir"La hipotenusa es:", hipotenusa
  Escribir"La area es:", area
Fin_Algoritmo
