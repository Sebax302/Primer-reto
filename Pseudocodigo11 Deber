 Algoritmo Sumar_Hasta_Cero
  //Declaraciones   
    Definir num, suma Como Entero
  //Cuerpo
    suma <- 0
    Escribir "Ingrese un numero (0 para terminar)"
    Leer num
    Mientras num <> 0 Hacer
        suma <- suma + num
        Escribir "Ingrese un numero (0 para terminar) "
        Leer num
    FinMientras
    Escribir "La suma total es: ", suma
FinAlgoritmo
