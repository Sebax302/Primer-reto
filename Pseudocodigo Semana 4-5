Algoritmo Cuota_prestamo_interes_simple
    //Declaraciones
    Definir capital, tasa, interes, cuota Como Real
    Definir meses Como Entero
    //Cuerpo
      Escribir "Ingrese el capital"
        Leer capital
      Escribir "Ingrese la tasa anual en decimal"
        Leer tasa
      Escribir "Ingrese el numero de meses"
        Leer meses
    interes <- capital * tasa * (meses / 12)
    cuota <- (capital + interes) / meses
      Escribir "El interes total es:", interes
      Escribir "La cuota mensual es:", cuota
Fin_Algoritmo
