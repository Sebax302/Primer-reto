Algoritmo Promedio_N_Notas
  //Declaraciones
  Definir N, contador como entero
  Definir nota , suma, promedio como real
  //Cuerpo
  suma <- 0
  Escribir "Ingrese la cantidad de calificaciones"
     Para contador <- 1 Hasta N Hacer
        Escribir "Ingrese una calificacion"
        Leer nota
  suma <- suma + nota
    FinPara
    promedio <- suma / N
    Escribir "El promedio es:", promedio
FinAlgoritmo
