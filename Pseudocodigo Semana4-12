Algoritmo Numero_Armstrong
    //Declaraciones
    Definir numero, original, digito, suma Como Entero
    //Cuerpo
      Escribir "Ingrese un numero de tres digitos"
        Leer numero
    original <- numero
    suma <- 0
    Mientras numero > 0 Hacer
        digito <- numero MOD 10
        suma <- suma + digito^3
        numero <- Trunc(numero / 10)
    FinMientras
