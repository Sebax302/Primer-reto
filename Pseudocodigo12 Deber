Algoritmo Tabla_De_Multiplicar
  //Declaraciones
  definir K, iz resultado como entero
  //Cuerpo
    Escribir "Ingrese un numero entero:"
    Leer K
    i <- 1
    Mientras i <= 10 Hacer
        resultado <- K * i
        Escribir K, " x ", i, " = ", resultado
        i <- i + 1
    FinMientras
FinAlgoritmo

  
