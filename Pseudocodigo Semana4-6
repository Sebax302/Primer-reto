Algoritmo Clasificacion_estudiante
    //Declaraciones
    Definir promedio, asistencia Como Real
    Definir categoria Como Caracter
    //Cuerpo
    Escribir "Ingrese el promedio"
    Leer promedio
    Escribir "Ingrese el porcentaje de asistencia"
    Leer asistencia
    Si promedio >= 9 Entonces
        Si asistencia >= 90 Entonces
            categoria <- "Excelente"
        SiNo
            Si promedio >= 7 Y asistencia >= 80 Entonces
                categoria <- "Bueno"
            SiNo
                Si promedio >= 6 Y asistencia >= 70 Entonces
                    categoria <- "Regular"
                SiNo
                    categoria <- "Deficiente"
                FinSi
            FinSi
        FinSi
    SiNo
        Si promedio >= 7 Y asistencia >= 80 Entonces
            categoria <- "Bueno"
        SiNo
            Si promedio >= 6 Y asistencia >= 70 Entonces
                categoria <- "Regular"
            SiNo
                categoria <- "Deficiente"
            FinSi
        FinSi
    FinSi
    Escribir "La categoria es:", categoria
Fin_Algoritmo
