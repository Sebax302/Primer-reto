Algoritmo_Promedio_Notas
//Declaraciones
Definir n1, n2, n3 , prom como real
//Cuerpo
//Control de n1
  Escribir"Ingrese la nota1,entre 0 y 10"
 Leer n1
mientras n1< 0 o n1 <=10 hacer
  Escribir"Nota invalida"
  Escribir"Ingrese nuevamente la nota con los valores entre 0 y 10"
 Leer n1
Fin_Mientras

//Control de n2
  Escribir"Ingrese la nota2,entre 0 y 10"
 Leer n2
mientras n2< 0 o n2 <=10 hacer
  Escribir"Nota invalida"
  Escribir"Ingrese nuevamente la nota con los valores entre 0 y 10"
 Leer n2
Fin_Mientras

//Control de n3
  Escribir"Ingrese la nota3,entre 0 y 10"
 Leer n3
mientras n3< 0 o n3 <=10 hacer
  Escribir"Nota invalida"
  Escribir"Ingrese nuevamente la nota con los valores entre 0 y 10"
 Leer n3
Fin_Mientras
prom=(n1+ n2+ n3) /3
  Escribir"El promedio es:", prom
Fin_Algoritmo
