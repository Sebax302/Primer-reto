Algoritmo Conversor_unidades
    // Declaraciones
    Definir opcion Como Entero
    Definir valor, resultado Como Real
    // Cuerpo
    Escribir "CONVERSOR DE UNIDADES"
    Escribir "1. Kilometros a metros"
    Escribir "2. Metros a centimetros"
    Escribir "3. Horas a minutos"
    Escribir "4. Salir"
    Escribir "Seleccione una opcion:"
    Leer opcion
    Segun opcion Hacer
        1:
            Escribir "Ingrese los kilometros:"
            Leer valor
            resultado <- valor * 1000
            Escribir "Resultado: ", resultado, " metros"
        2:
            Escribir "Ingrese los metros:"
            Leer valor
            resultado <- valor * 100
            Escribir "Resultado: ", resultado, " centimetros"
        3:
            Escribir "Ingrese las horas:"
            Leer valor
            resultado <- valor * 60
            Escribir "Resultado: ", resultado, " minutos"
        4:
            Escribir "Saliendo del conversor"
        De Otro Modo:
            Escribir "Opcion no valida"
    FinSegun
FinAlgoritmo
