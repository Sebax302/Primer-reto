Algortimo Bono_Por_Productividad
  //Declaraciones
    Definir sueldoBase, productividad como real
    Definir porcentajeBono, bono, totalPagar como real
    Escribir "Ingrese el sueldo base"
    Leer sueldoBase
    Escribir "Ingrese el porcentaje de productividad:"
    Leer productividad
    Si productividad >= 90 entonces
        porcentajeBono <- 20
    SiNo
        Si productividad >= 70 entonces
            porcentajeBono <- 10
        SiNo
            Si productividad >= 50 entonces
                porcentajeBono <- 5
            SiNo
                porcentajeBono <- 0
            FinSi
        FinSi
    FinSi
    bono <- sueldoBase * porcentajeBono / 100
    totalPagar <- sueldoBase + bono
    Escribir "Porcentaje de bono: ", porcentajeBono, "%"
    Escribir "Valor del bono: ", bono
    Escribir "Total a pagar: ", totalPagar
FinAlgoritmo
