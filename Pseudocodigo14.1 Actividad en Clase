Algoritmo Conversion_Decimal_Hexadecimal
  //Declaraciones
  Definir N, res, cociente como entero
  Definir hexadecimal como cadena
  //Cuerpo
  Escribir "Ingrese el numero decimal"
    Leer N
  hexadecimal <- ""
  Mientras N > 0 Hacer
    res <- N MOD 16
    Si res < 10 Entonces
      hexadecimal <- ConvertirATexto(res) + hexadecimal
    SiNo
      Si res = 10 Entonces
        hexadecimal <- "A" + hexadecimal
      SiNo
        Si res = 11 Entonces
          hexadecimal <- "B" + hexadecimal
        SiNo
          Si res = 12 Entonces
            hexadecimal <- "C" + hexadecimal
          SiNo
            Si res = 13 Entonces
              hexadecimal <- "D" + hexadecimal
            SiNo
              Si res = 14 Entonces
                hexadecimal <- "E" + hexadecimal
              SiNo
                hexadecimal <- "F" + hexadecimal
              FinSi
            FinSi
          FinSi
        FinSi
      FinSi
    FinSi
    cociente <- Trunc(N / 16)
    N <- cociente
  FinMientras
  Escribir "El numero hexadecimal es: ", hexadecimal
Fin_Algoritmo
