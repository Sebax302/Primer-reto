Algoritmo Validacion_De_Fecha
  //Declaraciones
    Definir dia, mes, anio, diasMes como entero
    Escribir "Ingrese el dia"
    Leer dia
    Escribir "Ingrese el mes (1-12)"
    Leer mes
    Escribir "Ingrese el anio"
    Leer anio
    Si mes < 1 O mes > 12 O anio < 1 entonces
        Escribir "La fecha no es valida"
    SiNo
        Segun mes Hacer
            1, 3, 5, 7, 8, 10, 12:
                diasMes <- 31
            4, 6, 9, 11:
                diasMes <- 30
            2:
                Si (anio MOD 400 = 0) O ((anio MOD 4 = 0) Y (anio MOD 100 <> 0)) entonces
                    diasMes <- 29
                SiNo
                    diasMes <- 28
                FinSi
        FinSegun
        Si dia >= 1 Y dia <= diasMes entonces
            Escribir "La fecha es valida"
        SiNo
            Escribir "La fecha no es valida"
        FinSi
    FinSi
FinAlgoritmo
