Algoritmo Clasificacion_temperatura_Loja
    // Declaraciones
    Definir temperatura Como Real
    // Cuerpo
    Escribir "Ingrese la temperatura en grados Celsius (°C):"
    Leer temperatura
    Si temperatura < 15 Entonces
        Escribir "Frio"
    Sino
        Si temperatura <= 25 Entonces
            Escribir "Templado"
        Sino
            Si temperatura > 25 Entonces
                Escribir "Calido"
                Si temperatura > 30 Entonces
                    Escribir "ALERTA: Calor extremo"
                FinSi
            FinSi
        FinSi
    FinSi
FinAlgoritmo
