Algoritmo Suma_serie_armonica
    //Declaraciones
    Definir N, i Como Entero
    Definir suma Como Real
    //Cuerpo
      Escribir "Ingrese N"
        Leer N
    suma <- 0
    Para i <- 1 Hasta N Hacer
        suma <- suma + 1 / i
    FinPara
    Escribir "La suma de la serie es:", suma
Fin_Algoritmo
