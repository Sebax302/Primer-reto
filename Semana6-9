Algoritmo Clasificacion_notas
    // Declaraciones
    Definir letra Como Caracter
    // Cuerpo
    Escribir "Ingrese su letra de calificacion (A, B, C, D, F):"
    Leer letra
    Segun letra Hacer
        "A":
            Escribir "Rango de nota: 9 - 10"
        "B":
            Escribir "Rango de nota: 8 - 8.9"
        "C":
            Escribir "Rango de nota: 7 - 7.9"
        "D":
            Escribir "Rango de nota: 6 - 6.9"
        "F":
            Escribir "Rango de nota: 0 - 5.9"
        De Otro Modo:
            Escribir "Letra de calificacion no valida"
    FinSegun
FinAlgoritmo
