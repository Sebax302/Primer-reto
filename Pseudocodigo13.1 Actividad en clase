Algoritmo Ahorro_Interes_Compuesto_Mensual
  //Declaraciones
  Definir capital, deposito, N, tasa, saldo, mes como real
  //Cuerpo
  Escribir "Ingrese el capital inicial"
    Leer capital
  Escribir "Ingrese el deposito mensual"
    Leer deposito
  Escribir "Ingrese el numero de meses"
    Leer N
  Escribir "Ingrese la tasa de interes"
    Leer tasa
  saldo <- capital
  mes <- 1
  Mientras mes <= N Hacer
    saldo <- saldo + deposito
    saldo <- saldo + (saldo * tasa / 100)
    Escribir "El saldo del mes ", mes, " es: ", saldo
    mes <- mes + 1
  FinMientras
Fin_Algoritmo
