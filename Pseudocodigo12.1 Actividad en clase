Algoritmo Numeros_Perfectos
  //Declaraciones
  Definir N, sumaD, D, res como entero
  Escribir"Ingrese el numero"
    Leer N
  sumaD <- 0
  D <- 1
  Mientras D <= N/2 Hacer
    res <- N MOD D
    Si res = 0 Entonces
      sumaD <- sumaD + D
    FinSi
    D <- D+1
  FinMientras
    Si sumaD = N Y N > 0 Entonces
        Escribir"El numero es perfecto"
    SiNo
        Escribir"El numero no es perfecto"
    FinSi
Fin_Algoritmo
