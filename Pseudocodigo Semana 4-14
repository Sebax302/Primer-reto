Algoritmo Multiplos_de_3_y_5
    //Declaraciones
    Definir N, i, cantidad, suma Como Entero
    //Cuerpo
      Escribir "Ingrese N"
        Leer N
    cantidad <- 0
    suma <- 0
    Para i <- 1 Hasta N Hacer
        Si i MOD 3 = 0 O i MOD 5 = 0 Entonces
            cantidad <- cantidad + 1
            suma <- suma + i
        FinSi
    FinPara
    Escribir "La cantidad de multiplos es:", cantidad
    Escribir "La suma de los multiplos es:", suma
Fin_Algoritmo
