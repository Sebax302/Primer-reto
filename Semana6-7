Algoritmo Dia_semana
    // Declaraciones
    Definir dia Como Entero
    Definir nombre Como Caracter
    Definir actividad Como Caracter
    // Cuerpo
    Escribir "Ingrese un numero del 1 al 7:"
    Leer dia
    Segun dia Hacer
        1:
            nombre <- "Lunes"
            actividad <- "Dia de clases"
        2:
            nombre <- "Martes"
            actividad <- "Dia de clases"
        3:
            nombre <- "Miercoles"
            actividad <- "Dia de clases"
        4:
            nombre <- "Jueves"
            actividad <- "Dia de clases"
        5:
            nombre <- "Viernes"
            actividad <- "Dia de clases"
        6:
            nombre <- "Sabado"
            actividad <- "Fin de semana"
        7:
            nombre <- "Domingo"
            actividad <- "Fin de semana"
        De Otro Modo:
            Escribir "Numero de dia invalido"
    FinSegun

    Si dia >= 1 Y dia <= 7 Entonces
        Escribir "Dia: ", nombre
        Escribir "Actividad: ", actividad
    FinSi
FinAlgoritmo
