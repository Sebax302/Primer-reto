Algoritmo Area perimetro de un rectangulo
  //Declaraciones
  Definir area, perimetro, largo, ancho como real
//Cuerpo
  Escribir"Ingresar ancho del terreno"
Leer ancho
  Escribir"Ingresar largo del terreno"
Leer largo
area <- largo * ancho
perimetro <- 2*(largo * ancho)
  Escribir"El area del terreno es:", area
  Escribir"EL perimetro deel terreno es:", perimetro
Fin_Algoritmo
