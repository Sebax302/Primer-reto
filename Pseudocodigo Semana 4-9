Algoritmo Descuento_tienda
    //Declaraciones
    Definir monto, descuento, total Como Real
    Definir frecuente Como Caracter
    //Cuerpo
      Escribir "Ingrese el monto de compra"
        Leer monto
    Escribir "Es cliente frecuente? S/N"
        Leer frecuente
    Si monto >= 500 Entonces
        descuento <- 0.15
    SiNo
        Si monto >= 300 Entonces
            descuento <- 0.10
        SiNo
            Si monto >= 100 Entonces
                descuento <- 0.05
            SiNo
                descuento <- 0
            FinSi
        FinSi
    FinSi
    Si frecuente = "S" Entonces
        descuento <- descuento + 0.05
    FinSi
    total <- monto * (1 - descuento)
    Escribir "El descuento es:", descuento * 100, "%"
    Escribir "El total a pagar es:", total
Fin_Algoritmo
