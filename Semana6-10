Algoritmo Transporte_Loja
    // Declaraciones
    Definir opcion Como Entero
    // Cuerpo
    Escribir "MEDIOS DE TRANSPORTE EN LOJA"
    Escribir "1. Bus urbano"
    Escribir "2. Taxi"
    Escribir "3. Bicicleta"
    Escribir "4. Caminar"
    Escribir "Seleccione su transporte:"
    Leer opcion
    Segun opcion Hacer
        1:
            Escribir "Tiempo estimado: 25 minutos"
            Escribir "Transporte economico, puede tener paradas."
        2:
            Escribir "Tiempo estimado: 12 minutos"
            Escribir "Transporte rapido y comodo."
        3:
            Escribir "Tiempo estimado: 20 minutos"
            Escribir "Transporte saludable y ecologico."
        4:
            Escribir "Tiempo estimado: 60 minutos"
            Escribir "Actividad fisica y saludable."
        De Otro Modo:
            Escribir "Opcion no valida"
    FinSegun
FinAlgoritmo
