Algoritmo Bono_empresa_Loja
    // Declaraciones
    Definir antiguedad Como Real
    Definir sueldo, bono, sueldo_total Como Real
    Definir evaluacion Como Caracter
    // Cuerpo
    Escribir "Ingrese los años de antiguedad:"
    Leer antiguedad
    Escribir "Ingrese su sueldo:"
    Leer sueldo
    Escribir "¿Tiene evaluacion excelente? (si/no)"
    Leer evaluacion
    bono <- 0
    Si antiguedad > 2 Entonces
        bono <- 10
        Si evaluacion = "si" Entonces
            bono <- bono + 5
        FinSi
    Sino
        Si antiguedad < 2 Entonces
            Si evaluacion = "si" Entonces
                bono <- 5
            FinSi
        FinSi
    FinSi
    sueldo_total <- sueldo + (sueldo * bono / 100)
    Escribir "Porcentaje de bono: ", bono, "%"
    Escribir "Valor del bono: $", sueldo * bono / 100
    Escribir "Sueldo total a recibir: $", sueldo_total
FinAlgoritmo
