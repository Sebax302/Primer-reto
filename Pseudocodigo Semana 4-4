Algoritmo Conversion_coordenadas_polares
    //Declaraciones
    Definir radio, angulo, radianes, x, y Como Real
    //Cuerpo
      Escribir "Ingrese el radio"
        Leer radio
      Escribir "Ingrese el angulo en grados"
        Leer angulo
    radianes <- angulo * PI / 180
    x <- radio * cos(radianes)
    y <- radio * sen(radianes)

      Escribir "La coordenada x es:", x
      Escribir "La coordenada y es:", y
Fin_Algoritmo
