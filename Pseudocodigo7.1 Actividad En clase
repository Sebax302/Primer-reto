Algoritmo Sistema_Tarifa_De_Taxis
  //Declaraciones
  Definir km como real
  Definir tarifaBase, total como real
  Definir noche como caracter 
  //Cuerpo
  Escribir"Ingrese el numero de kilometros recorridos"
  Leer km
  Escribir "Es de noche? Ingrese S para Si o N para No:"
    Leer noche
    // Calcular tarifa base
    tarifaBase <- 2.00 + (1.50 * km)
    total <- tarifaBase
    // Aplicar recargo por distancia
    Si km > 10 Entonces
        total <- total + (tarifaBase * 0.20)
    FinSi
    // Aplicar recargo nocturno
    Si noche = "S" O noche = "s" entonces
        total <- total + (tarifaBase * 0.30)
    FinSi
    // Mostrar resultado
    Escribir "Tarifa base: ", tarifaBase
    Escribir "Total a pagar: ", total
FinAlgoritmo
