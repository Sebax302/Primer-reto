Algoritmo PromedioFinalUTPL_LOJA
//Declaraciones
Definir nota1,nota2,nota3,promedio como real

//Control de ingreso de nota1
Escribir "Ingrese la nota del primer parcial (0 a la 10)"
Leer nota1 
mientras nota1 < 0 o nota 1 <= 10 hacer
  Escribir"Nota invalida. Debe estar entre 0 y 10"
  Escribir"Ingrese nuevamente la nota del primer parcial"
Leer nota1
Fin_mientras

//Control de ingreso nota2
Escribir "Ingrese la nota del primer parcial (0 a la 10)"
Leer nota2
mientras nota2 < 0 o nota2 <= 10 hacer
  Escribir"Nota invalida. Debe estar entre 0 y 10"
  Escribir"Ingrese nuevamente la nota del primer parcial"
Leer nota2
Fin_mientras

//Control de ingreso nota3
Escribir "Ingrese la nota del primer parcial (0 a la 10)"
Leer nota3
mientras nota3 < 0 o nota3 <= 10 hacer
  Escribir"Nota invalida. Debe estar entre 0 y 10"
  Escribir"Ingrese nuevamente la nota del primer parcial"
Leer nota3
Fin_mientras

//Calculo del promedio ponderado
promedio<- (nota1 * 0.30) + (nota2 * 0.30) + (nota3 *0.40)
Escribir "El promedio final es: ",promedio 
//Control de aprobacionn 
si promedio >= 7 entonces 
  Escribir "El estudiante aprueba la asigantura"
  Sino
  Escribir" El estudiante no aprueba la asignatura"
 FinSi
FinAlgoritmo


