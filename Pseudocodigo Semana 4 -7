Algoritmo Tarifa_estacionamiento
    //Declaraciones
    Definir horas, tarifa, total Como Real
    Definir nocturno Como Caracter
    //Cuerpo
      Escribir "Ingrese las horas"
        Leer horas
      Escribir "Es horario nocturno? S/N"
        Leer nocturno
    tarifa <- 1.50
    total <- horas * tarifa
    Si horas > 8 Entonces
        total <- total * 1.25
    FinSi
    Si nocturno = "S" Entonces
        total <- total * 1.30
    FinSi
      Escribir "El total a pagar es:", total
Fin_Algoritmo
