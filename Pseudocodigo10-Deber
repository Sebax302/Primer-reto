Algoritmo Numero menor
  //Declaraciones
  Definir n1, n2, n3 como real
  //Cuerpo
  Escribir"Ingrese el primer numero"
  Leer n1
  Escribir"Ingrese el segundo numero"
  Leer n2
  Escribir"Ingrese el tercer numero"
  Leer n3
  si n1 <= n2 entonces
  menor <- num1
  si n2 <= n3 entonces
  menor <- n2
  FinSi
  FinSi
  Escribir "El menor de los tres numeros es: ", menor
FinAlgoritmo
  

