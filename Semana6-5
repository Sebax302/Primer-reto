Algoritmo Tarifa_parqueadero_Loja
    // Declaraciones
    Definir estudiante Como Caracter
    Definir horas, tarifa, total Como Real
    // Cuerpo
    Escribir "¿Es estudiante UTPL? (si/no)"
    Leer estudiante
    Escribir "Ingrese las horas de permanencia:"
    Leer horas
    tarifa <- horas * 1.00
    Si estudiante = "si" Entonces
        tarifa <- tarifa * 0.50
        Si horas > 4 Entonces
            tarifa <- tarifa * 1.20
        FinSi
    Sino
        Si horas > 6 Entonces
            tarifa <- tarifa * 1.20
        FinSi
    FinSi
    Escribir "Total a pagar: $", tarifa
FinAlgoritmo
